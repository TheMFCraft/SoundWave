<?xml version="1.0" encoding="utf-8"?>
<!-- Local Jam talks HTTP on LAN. Remote APIs (lyrics) already use HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
